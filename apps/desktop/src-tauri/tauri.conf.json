{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevDock",
  "version": "0.2.0",
  "identifier": "com.safeqq.devdock",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Safeqq",
    "homepage": "https://github.com/Safeqq/devdock",
    "copyright": "Copyright (c) 2026 Safeqq. MIT License.",
    "category": "DeveloperTool",
    "shortDescription": "Run your Node.js project scripts from one window",
    "licenseFile": "../../../LICENSE",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
